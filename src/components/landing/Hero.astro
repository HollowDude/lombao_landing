---
import { Check, CheckCircle2 } from 'lucide-astro';

const deployLines = [
	{ text: 'build superado en 1.2s', tone: 'accent' },
	{ text: 'tests 48/48 en verde', tone: 'accent' },
	{ text: 'despliegue en producción', tone: 'brand' },
] as const;
---

<section
	id="top"
	class="relative flex min-h-[90vh] items-center overflow-hidden scroll-mt-24 section-py text-on-surface"
>
	<div class="container-site relative z-10 grid items-center gap-12 md:grid-cols-2">
		<div class="flex flex-col gap-6">
			<h1 class="text-h1 text-on-surface">Software Boutique para Ideas Extraordinarias</h1>
			<p class="text-lead text-on-surface-muted max-w-xl">
				Transformamos conceptos complejos en soluciones digitales de alto impacto. Diseño,
				desarrollo y estrategia con sello Lombao.
			</p>
			<div class="mt-2 flex flex-wrap gap-4">
				<a class="btn btn-primary btn--pill" href="#contact">Empezar Proyecto</a>
				<a
					class="btn btn-soft btn--pill border-brand-soft text-brand-soft hover:bg-brand-soft/10"
					href="#approach"
				>
					Ver cómo trabajamos
				</a>
			</div>
			<ul class="mt-2 flex flex-col gap-2 sm:flex-row sm:gap-6">
				<li class="text-body-sm text-on-surface-muted flex items-center gap-2">
					<CheckCircle2 class="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
					Respuesta en menos de 24h
				</li>
				<li class="text-body-sm text-on-surface-muted flex items-center gap-2">
					<CheckCircle2 class="h-4 w-4 shrink-0 text-brand" aria-hidden="true" />
					Presupuesto sin compromiso
				</li>
			</ul>
		</div>

		<!-- Panel metodología (placeholder de imagen real) -->
		<div
			class="group relative flex h-[400px] items-center justify-center overflow-hidden rounded-2xl border border-border-subtle bg-ink md:h-[600px]"
		>
			<!-- TODO: reemplazar por asset real (imagen de metodología) -->
			<div class="absolute inset-0 bg-gradient-brand opacity-30"></div>
			<div class="absolute inset-0 z-10 bg-gradient-to-tr from-ink via-transparent to-transparent"></div>
			<div class="relative z-20 w-full max-w-md px-6">
				<div class="overflow-hidden rounded-xl border border-neutral-100/10 bg-ink/90 shadow-2xl">
					<div class="flex items-center gap-2 border-b border-neutral-100/10 px-4 py-3">
						<span class="h-3 w-3 rounded-full bg-brand" aria-hidden="true"></span>
						<span class="h-3 w-3 rounded-full bg-accent" aria-hidden="true"></span>
						<span class="h-3 w-3 rounded-full bg-neutral-500" aria-hidden="true"></span>
						<span class="ml-2 font-mono text-xs text-neutral-500">lombao — deploy</span>
					</div>
					<div class="text-body-sm flex flex-col gap-2.5 p-5 font-mono leading-relaxed">
						<p class="text-neutral-100">
							<span class="text-brand-soft">$</span> lombao deploy --prod
						</p>
						{
							deployLines.map((line) => (
								<p class="flex items-center gap-2 text-neutral-100/80">
									<Check
										class={`h-4 w-4 shrink-0 ${line.tone === 'accent' ? 'text-accent' : 'text-brand-soft'}`}
										aria-hidden="true"
									/>
									{line.text}
								</p>
							))
						}
						<p class="text-neutral-100/80">
							<span class="text-accent">→</span> tu-producto.com{' '}
							<span class="text-neutral-500">en vivo</span>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>