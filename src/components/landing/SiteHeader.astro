---
import { Menu } from 'lucide-astro';
---

	<header class="fixed inset-x-0 top-0 z-50 glass--dark">
	<div class="container-site flex items-center justify-between py-4">
		<a href="#top" class="flex items-center gap-2">
			<img src="/lombao-logo-02.png" alt="Lombao Studio" class="h-10 w-auto" />
		</a>

		<nav class="hidden gap-8 md:flex md:items-center" aria-label="Principal">
			<a class="nav-link text-neutral-100 hover:text-brand-soft" href="#services">Servicios</a>
			<a class="nav-link text-neutral-100 hover:text-brand-soft" href="#projects">Proyectos</a>
			<a class="nav-link text-neutral-100 hover:text-brand-soft" href="#about">Nosotros</a>
		</nav>

		<a class="btn btn-primary btn--pill hidden md:inline-flex" href="#contact">Contacto</a>

		<button
			id="menu-toggle"
			type="button"
			class="inline-flex items-center justify-center p-2 text-neutral-100 md:hidden"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<Menu class="h-6 w-6" />
		</button>
	</div>

	<div id="mobile-menu" class="hidden glass--dark md:hidden">
		<nav class="container-site flex flex-col gap-1 py-4" aria-label="Móvil">
			<a class="nav-link text-neutral-100 hover:text-brand-soft py-2" href="#services">Servicios</a>
			<a class="nav-link text-neutral-100 hover:text-brand-soft py-2" href="#projects">Proyectos</a>
			<a class="nav-link text-neutral-100 hover:text-brand-soft py-2" href="#about">Nosotros</a>
			<a class="btn btn-primary btn--pill mt-3 w-full" href="#contact">Contacto</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const open = menu.classList.toggle('hidden') === false;
			toggle.setAttribute('aria-expanded', String(open));
		});
	}
</script>