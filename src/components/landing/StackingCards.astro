---
const items = [
	{
		title: 'Descubrimiento',
		desc: 'Escuchamos, auditamos y definimos alcance, prioridades y métricas antes de escribir una sola línea de código.',
		variant: 'dark',
		image: '/services/descubrimiento.jpg',
	},
	{
		title: 'Construcción',
		desc: 'Diseño y desarrollo iterativo con entregas visibles cada semana. Sin cajas negras ni sorpresas al final.',
		variant: 'brand',
		image: '/services/construccion.jpg',
	},
	{
		title: 'Crecimiento',
		desc: 'Despliegue, medición y evolución continua: tu producto mejora después del lanzamiento, no se congela.',
		variant: 'accent',
		image: '/services/crecimiento.jpg',
	},
];

const variantClasses: Record<string, string> = {
	dark: 'glass--dark text-neutral-100',
	brand: 'glass--brand text-white',
	accent: 'glass--accent text-ink',
};
---

<section id="approach" class="relative scroll-mt-24 section-py text-on-surface">
	<div class="container-site relative z-10">
		<div class="mx-auto mb-16 max-w-2xl text-center">
			<h2 class="text-h2">Cómo Trabajamos</h2>
			<p class="text-body text-on-surface-muted mt-4">
				Un proceso claro en tres fases, sin cajas negras.
			</p>
		</div>

		<div class="stack-container mx-auto max-w-4xl">
			{
				items.map((it, i) => (
					<article
						class={`stack-card ${variantClasses[it.variant]}`}
						style={`top: calc(4rem + ${i} * 2.5rem); z-index: ${i + 1};`}
					>
						<h3 class="text-h3">{it.title}</h3>

						<div class="glass--dark my-6 aspect-video overflow-hidden rounded-xl">
							{/* TODO: <img src={it.image} alt="" loading="lazy" class="h-full w-full object-cover" /> cuando lleguen los assets reales (alt descriptivo solo si aporta info no repetida) */}
							<div class="bg-gradient-brand h-full w-full opacity-40"></div>
						</div>

						<p class="text-body mt-3">{it.desc}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
